# 값은 비워 두고 키 이름만 커밋합니다. 실제 값은 .env.local(로컬)과 Vercel 환경 변수에만 넣으세요.

# Firebase 웹 앱 (기존)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# 카카오 로그인 (서버 전용, NEXT_PUBLIC_ 붙이지 말 것)
KAKAO_REST_API_KEY=
# 카카오 디벨로퍼스 > 보안 > Client Secret 을 "사용함"으로 켰을 때만 필요
KAKAO_CLIENT_SECRET=
# 비워 두면 요청 주소 기준 {origin}/api/auth/kakao/callback 을 사용
KAKAO_REDIRECT_URI=

# Firebase Admin 서비스 계정 (서버 전용, 카카오 custom token 발급용)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# 한 줄로 넣을 때는 줄바꿈을 \n 으로: "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_PRIVATE_KEY=
